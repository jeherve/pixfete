{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "pixfete/event-album",
    "version": "1.1.0",
    "title": "Event Photo Album",
    "category": "media",
    "icon": "format-image",
    "description": "A photo sharing album for event guests.",
    "textdomain": "pixfete",
    "attributes": {
        "password": {
            "type": "string",
            "default": ""
        },
        "eventVersion": {
            "type": "integer",
            "default": 1
        },
        "dateRangeStart": {
            "type": "string",
            "default": ""
        },
        "dateRangeEnd": {
            "type": "string",
            "default": ""
        },
        "enableTableNames": {
            "type": "boolean",
            "default": false
        },
        "moderators": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "default": []
        }
    },
    "supports": {
        "html": false,
        "multiple": false
    },
    "editorScript": "file:./index.js",
    "viewScriptModule": "file:./view.js",
    "style": "file:./style-edit.css",
    "viewStyle": "file:./view.css",
    "render": "file:./render.php"
}
