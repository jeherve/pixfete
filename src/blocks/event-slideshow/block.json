{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "event-guest-photos-sharing/event-slideshow",
    "version": "1.0.0",
    "title": "Live Photo Wall",
    "category": "media",
    "icon": "slides",
    "description": "A full-screen live photo wall for projecting event photos.",
    "textdomain": "event-guest-photos-sharing",
    "attributes": {
        "password": {
            "type": "string",
            "default": ""
        },
        "eventVersion": {
            "type": "integer",
            "default": 1
        },
        "dateRangeStart": {
            "type": "string",
            "default": ""
        },
        "dateRangeEnd": {
            "type": "string",
            "default": ""
        },
        "interval": {
            "type": "integer",
            "default": 5
        },
        "eventPageId": {
            "type": "integer",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "multiple": false
    },
    "editorScript": "file:./index.js",
    "viewScriptModule": "file:./view.js",
    "viewStyle": "file:./view.css",
    "render": "file:./render.php"
}
